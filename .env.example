# LunaMatch local / Docker environment example
# Copy to .env and adjust. Never commit real secrets.

APP_ENV=development
CORS_ORIGINS=*
MODEL_DEVICE=cpu

DATABASE_URL=postgresql+psycopg://lunamatch:lunamatch@localhost:5432/lunamatch
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lunamatch
MINIO_SECURE=false
# Browser-facing MinIO host (Docker publish). Leave empty for local single-host.
MINIO_PUBLIC_ENDPOINT=localhost:9000

# Set true only for tests / single-process demos without a Celery worker
CELERY_TASK_ALWAYS_EAGER=false

PRESIGN_EXPIRY_SECONDS=900
MAX_UPLOAD_BYTES=52428800
